<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="config_google_sheet_spreadsheet_customer" model="ir.config_parameter">
        <field name="key">google.sheet.spreadsheet.customer</field>
        <field name="value">spreadsheet_name</field>
    </record>


    <record id="config_google_sheet_email_customer" model="ir.config_parameter">
        <field name="key">google.sheet.email.customer</field>
        <field name="value">example@gmail.com</field>
    </record>

    <record id="config_google_sheet_json_customer" model="ir.config_parameter">
        <field name="key">google.sheet.json.customer</field>
        <field name="value">json_file.json</field>
    </record>
    <record id="config_report_usage_customer" model="ir.config_parameter">
        <field name="key">report_usage_customer</field>
        <field name="value">False</field>
    </record>

</odoo>
