<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="clone_order_list_tree" model="ir.ui.view">
    <field name="name">clone.order.list.tree</field>
    <field name="model">clone.order.list</field>
    <field name="arch" type="xml">
        <tree string="Order List" editable="bottom" create="1" edit="1" import="1">
            <field name="order_name"/>
            <field name="order_id" invisible="1"/>
            <field name="partner_id"/>
            <field name="street"/>
            <field name="street2"/>
            <field name="country_id"/>
            <field name="zip_code"/>
            <field name="tracking_no"/>
            <field name="sku"/>
            <field name="picking_id" invisible='1'/>
            <field name="is_updated_sheet" invisible='1'/>
            <field name="shipping_address"/>
        </tree>
    </field>
  </record>

  <record id="action_clone_order_list_tree" model="ir.actions.act_window">
    <field name="name">Clone Order List</field>
    <field name="res_model">clone.order.list</field>
    <field name="view_mode">tree</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create a new Order List
        </p>
    </field>
</record>

<menuitem id="main_google_sheet_import"
            name="Clones"
            parent="stock.menu_stock_root"
            sequence="10"/>

<menuitem 
        id="menu_action_clone_order_list_tree" 
        parent="main_google_sheet_import" 
        action="action_clone_order_list_tree" 
        sequence="1" />

    <record id="make_invisible" model="res.groups">
        <field name="name">Invisible</field>
    </record>

    <record id="odoo_forge_google_sheet_customers.gsheetparentcontactscustomer" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="odoo_forge_google_sheet_customers.gsheetparentcrmcustomer" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="odoo_forge_google_sheet_customers.gsheetparentcustomer" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>


    <record id="odoo_forge_google_sheet_customers.gsheetwizcustomer" model="ir.ui.menu">
        <field name="parent_id" ref="main_google_sheet_import"/>
    </record>

    <record id="odoo_forge_google_sheet_customers.gsheetopenexternalsheet" model="ir.ui.menu">
        <field name="parent_id" ref="main_google_sheet_import"/>
    </record>

    <record id="odoo_forge_google_sheet_customers.action_open_google_sheet_external_customer" model="ir.actions.act_window">
        <field name="name">Open Previously Created Google Sheet</field>
    </record>

    <record id="action_google_sheet_name" model="ir.actions.act_window">
        <field name="name">Google Sheet Master</field>
        <field name="res_model">google.sheet.name</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Google Sheet Record
            </p>
        </field>
    </record>
    
    <menuitem 
        id="menu_action_google_sheet_name" 
        parent="main_google_sheet_import" 
        action="action_google_sheet_name" 
        sequence="20" />

    <record id="select_product_googlesheet_name_customer_inherit" model="ir.ui.view">
        <field name="name">select.google.sheet.name.view</field>
        <field name="model">google.sheet.name</field>
        <field name="inherit_id" ref="odoo_forge_google_sheet_customers.select_product_googlesheet_name_customer"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='url']" position="after">
                <field name="is_order_sheet"/>
                <field name="is_stock_sheet"/>
            </xpath>
        </field>
    </record>
        

</odoo>
