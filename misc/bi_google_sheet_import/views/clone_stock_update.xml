<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="clone_stock_updation_tree" model="ir.ui.view">
        <field name="name">clone.stock.update.tree</field>
        <field name="model">clone.stock.update</field>
        <field name="arch" type="xml">
            <tree string="Stock Updation List" editable="bottom" create="1" edit="1" import="1">
                <field name="sku"/>
                <field name="product_qty"/>
            </tree>
        </field>
      </record>


      <record id="action_clone_stock_updation_tree" model="ir.actions.act_window">
        <field name="name">Clone Stock Updation</field>
        <field name="res_model">clone.stock.update</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Stock Updation
            </p>
        </field>
    </record>

    
    <menuitem 
            id="menu_action_clone_stock_updation_tree" 
            parent="main_google_sheet_import" 
            action="action_clone_stock_updation_tree" 
            sequence="2" />

</odoo>
